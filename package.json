{
    "name": "base-frontend-template",
    "version": "1.0.0",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git://github.com:Viva-con-Agua/base-frontend-template.git"
    },
    "scripts": {
        "dev": "vite",
        "tailwind": "tailwind-config-viewer -o",
        "build": "vue-tsc --noEmit && vite build",
        "serve": "vite --port 6006",
        "serve_docker": "vite --port 28098 --host",
        "preview": "vite preview",
        "lint": "eslint --config=eslint.config.js --fix ./src",
        "types": "vue-tsc --noEmit",
        "format": "prettier . --write",
        "build-develop": "vue-tsc --noEmit && vite build --mode develop",
        "build-stage": "vue-tsc --noEmit && vite build --mode stage",
        "build-main": "vue-tsc --noEmit && vite build --mode main"
    },
    "dependencies": {
        "@kyvg/vue3-notification": "^3.4.1",
        "@vivaconagua/vueca": "^2.0.21",
        "@vuelidate/core": "^2.0.3",
        "@vuelidate/validators": "^2.0.4",
        "axios": "^1.9.0",
        "pinia": "^3.0.3",
        "pinia-plugin-persistedstate": "^4.3.0",
        "vue": "^3.5.16",
        "vue-axios": "^3.5.2",
        "vue-i18n": "^11.1.5",
        "vue-matomo": "^4.2.0",
        "vue-router": "^4.5.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.28.0",
        "@intlify/vite-plugin-vue-i18n": "^7.0.0",
        "@tailwindcss/postcss": "^4.1.8",
        "@types/node": "^22.15.30",
        "@typescript-eslint/eslint-plugin": "^8.33.1",
        "@typescript-eslint/parser": "^8.33.1",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.5.0",
        "autoprefixer": "^10.4.21",
        "eslint": "^9.28.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-markdown": "^5.1.0",
        "eslint-plugin-prettier": "^5.4.1",
        "eslint-plugin-vue": "^10.2.0",
        "globals": "^16.2.0",
        "jsdom": "^26.1.0",
        "postcss": "^8.5.4",
        "prettier": "^3.5.3",
        "prettier-plugin-tailwindcss": "^0.6.12",
        "sass": "^1.89.1",
        "tailwind-config-viewer": "^2.0.4",
        "tailwindcss": "^4.1.8",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.33.1",
        "vite": "^6.3.5",
        "vite-plugin-eslint": "^1.8.1",
        "vue-loader": "^17.4.2",
        "vue-tsc": "^2.2.10"
    }
}
