{
    "name": "base-frontend-template",
    "version": "1.0.0",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git://github.com:Viva-con-Agua/base-frontend-template.git"
    },
    "scripts": {
        "dev": "vite",
        "tailwind": "tailwind-config-viewer -o",
        "build": "vue-tsc --noEmit && vite build",
        "serve": "vite --port 6006",
        "serve_docker": "vite --port 28098 --host",
        "preview": "vite preview",
        "lint": "eslint --config=eslint.config.js --fix ./src",
        "types": "vue-tsc --noEmit",
        "format": "prettier . --write",
        "build-develop": "vue-tsc --noEmit && vite build --mode develop",
        "build-stage": "vue-tsc --noEmit && vite build --mode stage",
        "build-main": "vue-tsc --noEmit && vite build --mode main"
    },
    "dependencies": {
        "@kyvg/vue3-notification": "^3.3.0",
        "@vivaconagua/vueca": "^2.0.17",
        "@vuelidate/core": "^2.0.3",
        "@vuelidate/validators": "^2.0.4",
        "axios": "^1.7.7",
        "pinia": "^2.2.4",
        "pinia-plugin-persistedstate": "^4.1.1",
        "vue": "^3.5.11",
        "vue-axios": "^3.5.2",
        "vue-i18n": "^10.0.4",
        "vue-matomo": "^4.2.0",
        "vue-router": "^4.4.5"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.1.0",
        "@eslint/js": "^9.12.0",
        "@intlify/vite-plugin-vue-i18n": "^7.0.0",
        "@types/node": "^22.7.4",
        "@typescript-eslint/eslint-plugin": "^8.8.1",
        "@typescript-eslint/parser": "^8.8.1",
        "@vitejs/plugin-vue": "^5.1.4",
        "@vue/eslint-config-prettier": "^10.0.0",
        "@vue/eslint-config-typescript": "^14.0.0",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.12.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-markdown": "^5.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "eslint-plugin-vue": "^9.28.0",
        "globals": "^15.10.0",
        "jsdom": "^25.0.0",
        "postcss": "^8.4.47",
        "prettier": "^3.3.3",
        "prettier-plugin-tailwindcss": "^0.6.8",
        "sass": "^1.79.4",
        "tailwind-config-viewer": "^2.0.4",
        "tailwindcss": "^3.4.12",
        "typescript": "^5.5.4",
        "typescript-eslint": "^8.8.1",
        "vite": "^5.4.8",
        "vite-plugin-eslint": "^1.8.1",
        "vue-loader": "^17.4.2",
        "vue-tsc": "^2.1.6"
    }
}
